<Window x:Class="AllBenRecoil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="all@Ben-Recoil" Width="960" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Leelawadee UI" UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8094BC"/>
        <SolidColorBrush x:Key="LineBrush" Color="#18223A"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#0B1222"/>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="b" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="24">
                            <Border x:Name="bg" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1"/>
                            <Ellipse x:Name="dot" Width="18" Height="18" Fill="#94A3B8" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0284C7"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="dot" Property="Fill" Value="White"/>
                                <Setter TargetName="dot" Property="Margin" Value="23,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- หน้าต่างหลักพร้อมขอบเรืองแสง -->
    <Border CornerRadius="16" Background="#060A14" BorderThickness="1.5">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1D6BFF" Offset="0.0"/>
                <GradientStop Color="#00E5FF" Offset="0.5"/>
                <GradientStop Color="#C9A54A" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- แถบหัวโปรแกรม -->
            <Grid Grid.Row="0" Margin="0,0,0,20" MouseLeftButtonDown="Title_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#0D1627" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="0,0,12,0">
                        <Image x:Name="LogoImg" Width="26" Height="26" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="all@Ben" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="-Recoil" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC"/>
                            <Border Margin="8,2,0,2" Padding="6,2" CornerRadius="6" Background="#1E293B">
                                <TextBlock Text="STANDALONE" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Hardware-Free High Precision Recoil Engine · No G Hub Needed" FontSize="11" Foreground="#8094BC"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource ChromeBtn}" Content="&#xE921;" Click="Min_Click" ToolTip="ย่อลงถาด"/>
                    <Button Style="{StaticResource ChromeBtn}" Content="&#xE8BB;" Click="Close_Click" ToolTip="ปิดโปรแกรม"/>
                </StackPanel>
            </Grid>

            <!-- บอดี้แบ่ง 3 คอลัมน์ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- คอลัมน์ซ้าย: สวิตช์เปิด/ปิดหลัก -->
                <Border Grid.Column="0" Background="#0A101D" CornerRadius="14" BorderBrush="#142038" BorderThickness="1" Margin="0,0,16,0" Padding="16">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- ปุ่ม Power กลมใหญ่ -->
                        <Grid Width="150" Height="150" Cursor="Hand" MouseLeftButtonDown="Power_Click">
                            <Ellipse x:Name="PowerRing" Stroke="#EF4444" StrokeThickness="4" Opacity="0.85"/>
                            <Ellipse x:Name="PowerGlow" Fill="#EF4444" Opacity="0.12" Margin="10"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                           Foreground="#EF4444" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PowerStatusText" Text="OFF" FontSize="16" FontWeight="Bold"
                                           Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="PowerSubText" Text="มาโครปิดอยู่" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="#F0F6FC" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="คลิกปุ่ม หรือกดปุ่ม ` (ข้างเลข 1)" FontSize="11" Foreground="#8094BC"
                                   HorizontalAlignment="Center"/>

                        <Border Margin="0,24,0,0" Padding="10,8" Background="#0F172A" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="โหมดความปลอดภัย" FontSize="10.5" Foreground="#8094BC" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SafetyStatusText" Text="✓ ดึงเฉพาะตอนเล็งขวา (ADS)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- คอลัมน์กลาง: เลือกปืน / ปรับจูน / AI Detect -->
                <Border Grid.Column="1" Background="#0A101D" CornerRadius="14" BorderBrush="#142038" BorderThickness="1" Margin="0,0,16,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ช่องปืน 1, 2, 3 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Card1" Grid.Column="0" Margin="0,0,6,0" Background="#111A2E" CornerRadius="10" BorderBrush="#1D6BFF" BorderThickness="1.5" Cursor="Hand" MouseLeftButtonDown="SelectGun1" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="ช่อง 1" FontSize="10" Foreground="#8094BC"/>
                                    <TextBlock x:Name="Gun1NameText" Text="M416" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,2,0,4"/>
                                    <TextBlock x:Name="Gun1BaseText" Text="base 5.0" FontSize="10.5" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="Card2" Grid.Column="1" Margin="3,0,3,0" Background="#0F172A" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="SelectGun2" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="ช่อง 2" FontSize="10" Foreground="#8094BC"/>
                                    <TextBlock x:Name="Gun2NameText" Text="Beryl" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,2,0,4"/>
                                    <TextBlock x:Name="Gun2BaseText" Text="base 15.5" FontSize="10.5" Foreground="#8094BC"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="Card3" Grid.Column="2" Margin="6,0,0,0" Background="#0F172A" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="SelectGun3" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="ช่อง 3" FontSize="10" Foreground="#8094BC"/>
                                    <TextBlock x:Name="Gun3NameText" Text="AUG" FontSize="13" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,2,0,4"/>
                                    <TextBlock x:Name="Gun3BaseText" Text="base 6.0" FontSize="10.5" Foreground="#8094BC"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- แผงปรับจูน -->
                        <StackPanel Grid.Row="1" Margin="0,16,0,16" VerticalAlignment="Center">
                            <TextBlock x:Name="TuningGunTitle" Text="ปรับค่า · ช่อง 1 (M416)" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                            <!-- สไลเดอร์ Base Y -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="แรงดึงลง" VerticalAlignment="Center" FontSize="12" Foreground="#CBD5E1"/>
                                <Button Grid.Column="1" Style="{StaticResource KeyBtn}" Content="-" Padding="0" Height="26" Click="BaseMinus_Click"/>
                                <Slider x:Name="BaseSlider" Grid.Column="2" Minimum="0" Maximum="40" SmallChange="0.5" LargeChange="1.0"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="BaseSlider_ValueChanged"/>
                                <Button Grid.Column="3" Style="{StaticResource KeyBtn}" Content="+" Padding="0" Height="26" Click="BasePlus_Click"/>
                                <TextBlock x:Name="BaseValText" Grid.Column="4" Text="5.0" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- สไลเดอร์ X Drift -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ซ้าย / ขวา" VerticalAlignment="Center" FontSize="12" Foreground="#CBD5E1"/>
                                <Button Grid.Column="1" Style="{StaticResource KeyBtn}" Content="-" Padding="0" Height="26" Click="XMinus_Click"/>
                                <Slider x:Name="XSlider" Grid.Column="2" Minimum="-15" Maximum="15" SmallChange="0.5" LargeChange="1.0"
                                        VerticalAlignment="Center" Margin="8,0" ValueChanged="XSlider_ValueChanged"/>
                                <Button Grid.Column="3" Style="{StaticResource KeyBtn}" Content="+" Padding="0" Height="26" Click="XPlus_Click"/>
                                <TextBlock x:Name="XValText" Grid.Column="4" Text="0.0" FontWeight="Bold" Foreground="#CBD5E1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- ตัวคูณ AI -->
                            <Border Background="#0F172A" CornerRadius="8" Padding="10,8" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="ตัวคูณ AI จากของแต่ง / กล้อง" FontSize="11" Foreground="#8094BC" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MultiplierText" Text="1.00x (ค่าเดิม)" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- ปุ่ม AI Vision สแกนกระเป๋า -->
                            <Button x:Name="VisionBtn" Style="{StaticResource KeyBtn}" Margin="0,14,0,0" Padding="12,10"
                                    BorderBrush="#1D6BFF" Background="#0C1B33" Click="Vision_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="AI Detect ปืน · ของแต่ง · ลำกล้อง (กด Tab)" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- แถบโปรไฟล์ล่าง -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PresetMenuBtn" Grid.Column="0" Style="{StaticResource KeyBtn}" Content="โปรไฟล์: M416 เลเซอร์" Click="PresetMenu_Click" HorizontalAlignment="Stretch"/>
                            <Button Grid.Column="1" Style="{StaticResource KeyBtn}" Content="บันทึก" Margin="6,0,0,0" Click="SavePreset_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource KeyBtn}" Content="รีเซ็ต" Margin="6,0,0,0" Click="ResetPreset_Click"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- คอลัมน์ขวา: การตั้งค่าทั้งหมด -->
                <Border Grid.Column="2" Background="#0A101D" CornerRadius="14" BorderBrush="#142038" BorderThickness="1" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="การตั้งค่าระบบ" FontSize="13" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,0,0,12"/>

                            <!-- ปุ่มลัดเปิด/ปิด -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="ปุ่มลัดเปิด/ปิด" FontSize="11.5" Foreground="#8094BC" VerticalAlignment="Center"/>
                                <Button x:Name="HotkeyBtn" Style="{StaticResource KeyBtn}" Content="`" Width="75" Height="28" Padding="0" HorizontalAlignment="Right" Click="Hotkey_Click"/>
                            </Grid>

                            <!-- สลับปืนตามช่อง -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="สลับปืนตามช่อง" FontSize="11.5" Foreground="#8094BC" VerticalAlignment="Center"/>
                                <Button x:Name="SlotSwitchBtn" Style="{StaticResource KeyBtn}" Content="ปุ่ม 1 · 2 + ลูกกลิ้ง" Height="28" Padding="10,0" HorizontalAlignment="Right" Click="SlotSwitch_Click"/>
                            </Grid>

                            <!-- ดึงเฉพาะตอนเล็งขวา (ADS) -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ดึงเฉพาะตอนเล็งขวา (ADS)" FontSize="11.5" Foreground="#8094BC"/>
                                    <TextBlock Text="คลิกธรรมดาบน Desktop ไม่ดึง" FontSize="9.5" Foreground="#475569"/>
                                </StackPanel>
                                <CheckBox x:Name="RequireAdsToggle" Style="{StaticResource ToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="RequireAds_Click"/>
                            </Grid>

                            <!-- ไมโครจิสเตอร์เลียนแบบมือคน -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="ไมโครจิสเตอร์เลียนแบบมือโปร" FontSize="11.5" Foreground="#8094BC"/>
                                    <TextBlock Text="สุ่มขยับเสี้ยวพิกเซลป้องกันการแบน" FontSize="9.5" Foreground="#475569"/>
                                </StackPanel>
                                <CheckBox x:Name="HumanizeToggle" Style="{StaticResource ToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="Humanize_Click"/>
                            </Grid>

                            <!-- ป้ายบอกบนจอ OSD -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="ป้ายบอกบนจอเกม (OSD)" FontSize="11.5" Foreground="#8094BC" VerticalAlignment="Center"/>
                                <Button x:Name="OsdBtn" Style="{StaticResource KeyBtn}" Content="ตอนเปลี่ยน" Height="28" Padding="10,0" HorizontalAlignment="Right" Click="Osd_Click"/>
                            </Grid>

                            <!-- จอยืด Borderless -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="จอยืดอัตโนมัติ" FontSize="11.5" Foreground="#8094BC" VerticalAlignment="Center"/>
                                <Button x:Name="ResBtn" Style="{StaticResource KeyBtn}" Content="1728×1080 ในเกม" Height="28" Padding="10,0" HorizontalAlignment="Right" Click="Res_Click"/>
                            </Grid>

                            <!-- เสียงเตือน -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="เสียงแจ้งเตือน Beep" FontSize="11.5" Foreground="#8094BC" VerticalAlignment="Center"/>
                                <CheckBox x:Name="SoundToggle" Style="{StaticResource ToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" Click="Sound_Click"/>
                            </Grid>

                            <!-- เปิดพร้อม Windows -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="เปิดพร้อม Windows" FontSize="11.5" Foreground="#8094BC" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AutoStartToggle" Style="{StaticResource ToggleSwitch}" IsChecked="False" HorizontalAlignment="Right" Click="AutoStart_Click"/>
                            </Grid>

                            <Border Margin="0,10,0,0" Padding="12" Background="#060A14" CornerRadius="10" BorderBrush="#142038" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="⚡ ALLBEN ENGINE ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="• ขับเคลื่อนด้วย Multimedia 1ms Loop&#x0a;• เลเซอร์เคิร์ฟ v8 อัตโนมัติ&#x0a;• ไร้เงื่อนไข G Hub ใช้งานได้กับเมาส์ทุกยี่ห้อ" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
